{
  "name": "agenoras",
  "version": "0.1.4",
  "private": true,
  "description": "Desktop mail, calendar, contacts and tasks (IMAP/SMTP, CalDAV, CardDAV)",
  "author": "CiegoLink GmbH (https://ciegolink.com)",
  "homepage": "https://github.com/ciegolink/agenoras#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciegolink/agenoras.git"
  },
  "bugs": {
    "url": "https://github.com/ciegolink/agenoras/issues"
  },
  "license": "MIT",
  "keywords": [
    "electron",
    "email",
    "imap",
    "smtp",
    "caldav",
    "carddav",
    "calendar",
    "contacts"
  ],
  "main": "dist/main/main.js",
  "desktopName": "agenoras.desktop",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "tsc && electron . --ozone-platform=x11",
    "icons": "electron scripts/make-icons.js",
    "dist": "tsc && electron-builder",
    "dist:linux": "tsc && electron-builder --linux",
    "dist:win": "tsc && electron-builder --win",
    "dist:mac": "tsc && electron-builder --mac"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "imapflow": "^2.9.1",
    "mailparser": "^3.12.4",
    "node-llama-cpp": "^3.22.2",
    "nodemailer": "^10.2.1",
    "tsdav": "^2.5.0"
  },
  "devDependencies": {
    "@types/imapflow": "^1.0.23",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "ch.ciegolink.agenoras",
    "productName": "Agenoras",
    "copyright": "Copyright © 2026 CiegoLink GmbH",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/**/*.css",
      "lang/*.json",
      "build/**/*",
      "sounds/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/@node-llama-cpp/*-vulkan/**"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/bins/**",
      "node_modules/node-llama-cpp/llama/localBuilds/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office",
      "executableName": "agenoras",
      "maintainer": "CiegoLink GmbH <info@ciegolink.com>",
      "synopsis": "Mail, calendar, contacts and tasks",
      "syncDesktopName": true,
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "agenoras_amd64.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "x64ArchFiles": "**/node_modules/{@node-llama-cpp,@reflink}/**",
      "artifactName": "${productName}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ciegolink",
      "repo": "agenoras"
    }
  },
  "productName": "Agenoras"
}
